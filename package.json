{
  "name": "@tertium/gith",
  "version": "0.1.1",
  "description": "Git helper: branch flow with goal branches, release and hotfix containers, and everyday git commands.",
  "type": "module",
  "bin": {
    "gith": "./bin/gith.js"
  },
  "files": [
    "bin/"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outfile bin/gith.js --target node --banner \"#!/usr/bin/env node\"",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test": "bun test --no-coverage",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "release:patch": "node bin/gith.js release --patch",
    "release:minor": "node bin/gith.js release --minor",
    "release:major": "node bin/gith.js release --major",
    "version": "bun run build && node bin/gith.js changelog"
  },
  "license": "ISC",
  "author": "Vitalii Balabanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tertiumnon/tertium-gith.git"
  },
  "homepage": "https://github.com/Tertiumnon/tertium-gith#readme",
  "bugs": {
    "url": "https://github.com/Tertiumnon/tertium-gith/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.0.9",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "git",
    "branch",
    "flow",
    "gitflow",
    "release",
    "hotfix",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
